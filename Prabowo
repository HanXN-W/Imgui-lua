local M = {}

function M.RenderWindow(title, callback)
    local isOpen = true
    ImGui.SetNextWindowSize(400, 300, ImGui.Cond.FirstUseEver)
    
    local visible, open = ImGui.Begin(title, isOpen, 0)
    if visible then
        if callback then
            callback()
        end
    end
    ImGui.End()
end

function M.Text(text)
    ImGui.Text(text)
end

function M.Button(label)
    return ImGui.Button(label)
end

return M
